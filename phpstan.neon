includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes


    level: max

    tmpDir: /tmp/phpstan

    excludePaths:
        # exclude starter kit files
        - ./*/*/PasswordValidationRules.php
        - ./*/*/ProfileValidationRules.php
        - ./*/*/ProfileController.php
        - ./*/*/SecurityController.php
        - ./*/*/ProfileUpdateRequest.php
        - ./*/*/User.php
        - ./*/*/FortifyServiceProvider.php
        - ./*/*/UserFactory.php
        - ./routes/settings.php
        - ./routes/web.php
        - ./database/migrations/2026_05_14_074422_create_permission_tables.php
#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
